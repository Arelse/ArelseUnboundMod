{
	"schemaVersion": 1,
	"id": "arelse-unbound",
	"version": "${version}",
	"name": "Arelse Unbound Client",
	"description": "A client-side HUD with FPS, CPS, coordinates, potion effects, and durability, with a settings screen built into Mod Menu.",
	"authors": [
		"Arelse"
	],
	"contact": {
		"sources": "https://github.com/Arelse/ArelseUnboundMod"
	},
	"license": "CC0-1.0",
	"icon": "assets/arelse-unbound/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"arelse.unbound.ArelseUnbound"
		],
		"client": [
			"arelse.unbound.client.ArelseUnboundClient"
		],
		"modmenu": [
			"arelse.unbound.client.ArelseModMenuIntegration"
		]
	},
	"mixins": [
		"arelse-unbound.mixins.json",
		{
			"config": "arelse-unbound.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
